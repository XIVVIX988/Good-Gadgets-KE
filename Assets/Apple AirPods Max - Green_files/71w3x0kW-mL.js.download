endTime:g})}else h++}return f}function R(d){return M.apply(this,arguments)}function M(){M=T(n().m(function h(f){var g,c;return n().w(function(b){for(;;)switch(b.n){case 0:return b.n=1,fetch(f);case 1:g=b.v;if(g.ok){b.n=2;break}throw Error("VTT fetch failed: ".concat(g.status));case 2:return c=O,b.n=3,g.text();case 3:return b.a(2,c(b.v))}},h)}));return M.apply(this,arguments)}function A(d){return K.apply(this,arguments)}function K(){K=T(n().m(function h(f){var g,c,b,a,e,m,k,l,p,w,r,t,u,v,x,z,A,E,q;
return n().w(function(h){for(;;)switch(h.p=h.n){case 0:return h.p=0,h.n=1,fetch(f);case 1:c=h.v;if(c.ok){h.n=2;break}throw Error("Caption playlist fetch failed: ".concat(c.status));case 2:return h.n=3,c.json();case 3:g=h.v;h.n=5;break;case 4:return h.p=4,h.a(2,{parsedVtt:null,updateIntervalSeconds:void 0,lastSequenceNumber:void 0,sourceLanguage:"en",availableLanguages:[]});case 5:b=g;a=b.baseUrl;e=b.segments;m=b.updateIntervalSeconds;k=b.lastSequenceNumber;l=b.language;p=b.translations;w=l||"en";
r=p?Object.keys(p):[];if(m&&e&&0!==e.length){h.n=6;break}return h.a(2,{parsedVtt:null,updateIntervalSeconds:m,lastSequenceNumber:k,sourceLanguage:w,availableLanguages:r});case 6:return h.p=6,t="".concat(a,"/").concat(e[e.length-1].filename),h.n=7,fetch(t);case 7:u=h.v;if(u.ok){h.n=8;break}throw Error("Caption segment fetch failed: ".concat(u.status));case 8:return v=O,h.n=9,u.text();case 9:return x=v(h.v),z=m,A=k,E=w,q=r,h.a(2,{parsedVtt:x,updateIntervalSeconds:z,lastSequenceNumber:A,sourceLanguage:E,
availableLanguages:q});case 10:return h.p=10,h.a(2,{parsedVtt:null,updateIntervalSeconds:m,lastSequenceNumber:void 0,sourceLanguage:w,availableLanguages:r})}},h,null,[[6,10],[0,4]])}));return K.apply(this,arguments)}function G(d){"undefined"!==typeof r&&r.location&&r.location.assign(d)}function aa(d){if(!d.getElementById("asv-pyra-overlay-styles")){var f=d.createElement("style");f.id="asv-pyra-overlay-styles";f.textContent="/*\n * ASV Pyra overlay stylesheet.\n *\n * Source of truth for the overlay's visual layer. This file is:\n *   1. imported (as a string, via `./overlay.css?inline`) into mountOverlay so the\n *      built copy-machine bundle is self-contained and injects its own \x3cstyle\x3e tag, and\n *   2. copied verbatim to dist/overlay/overlay.css and published under the\n *      \"./overlay.css\" export, mirroring how @amzn/pyra ships ./inline-py/styles.css.\n *\n * The overlay sits ABOVE the Pyra player. The root layer is pointer-events:none so the\n * player's own controls keep receiving clicks; interactive children opt back in with\n * pointer-events:auto.\n */\n\n.asv-pyra-overlay {\n  position: absolute;\n  inset: 0;\n  /* Above Pyra's internal layers (top-overlay ~10, subtitle ~15, control-bar ~20,\n     header ~25) so the badge + title always persist, including during playback and\n     under Pyra's play-state gradients. Root stays pointer-events:none so Pyra's\n     controls beneath still receive clicks; interactive children opt back in. */\n  z-index: 30;\n  pointer-events: none;\n  overflow: hidden;\n  font-family: \"Amazon Ember\", Arial, sans-serif;\n}\n\n/* LIVE NOW / Just aired badge (top-left). Shown in BOTH live and previously-live\n   states; only the label text differs (set by mountOverlay per mode). */\n.asv-pyra-overlay__live-badge {\n  position: absolute;\n  top: 8px;\n  left: 8px;\n  display: none;\n  align-items: center;\n  justify-content: center;\n  gap: 2px;\n  padding: 1px 4px;\n  border-radius: 4px;\n  border: 1px solid #ff6200;\n  background: #ff6200;\n  color: #fff;\n  font-size: 13px;\n  font-weight: 400;\n  line-height: 18px;\n  pointer-events: auto;\n}\n\n.asv-pyra-overlay--live .asv-pyra-overlay__live-badge,\n.asv-pyra-overlay--postlive .asv-pyra-overlay__live-badge {\n  display: inline-flex;\n}\n\n/* Bottom title, rendered on a solid 40px black strip BELOW the video (see the\n   host rule below). Pyra renders title/creator at the top in largeMode, so the\n   player's video spec omits them and the overlay supplies the title here. */\n.asv-pyra-overlay__title {\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  height: 40px;\n  box-sizing: border-box;\n  padding: 0 12px;\n  /* Rio token $rio-color-background-inverse (#0F1111 light / #E3E6E6 dark), via its\n     CSS var so it is theme-aware where the host defines it; falls back to #0F1111. */\n  background: var(--rio-semantic-color-background-inverse, #0f1111);\n  color: #fff;\n  text-shadow: 0 0 4px #000;\n  /* Rio design tokens: $rio-font-family-display / $rio-font-weight-bold, mapped to\n     literals since this is plain CSS (no SCSS). Falls back to Amazon Ember. */\n  font-family: \"Amazon Ember Display\", \"Amazon Ember\", Arial, sans-serif;\n  font-size: 20px;\n  font-style: normal;\n  font-weight: 700;\n  line-height: 110%; /* 24.2px */\n  pointer-events: none;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* Reserve a 40px black strip BELOW the video for the bottom title: the title sits\n   on this strip instead of overlaying the video, increasing the player's total\n   height by 40px. Scoped to the overlay host so other inline-py instances on the\n   page are unaffected. */\n.asv-pyra-overlay-host {\n  padding-bottom: 40px;\n  background: var(--rio-semantic-color-background-inverse, #0f1111);\n  /* Round the whole player card to 12px and clip, so the video's top corners and\n     the title strip's bottom corners round together (the strip's top corners stay\n     square, flush against the video). Rounding the strip alone doesn't show because\n     the host's black background paints square corners behind it. */\n  border-radius: 12px;\n  overflow: hidden;\n}\n\n/* Brand/creator info box (Rio \"Box\" component), per the CX mockup: a single card\n   that WRAPS the video player AND a brand identity row below it. mountOverlay\n   reparents `container` (the player) inside this card as its first child, then\n   appends the identity row after it — so the card's top padding sits above the\n   video and its bottom padding sits below the identity row, while the video and\n   the identity row always span the card's full width. Hearts are intentionally\n   out of scope for this pass. */\n.asv-pyra-overlay-box {\n  box-sizing: border-box;\n  /* Full-bleed hook: when the box sits inside a padded host column (e.g. a detail\n     page's inline padding), set --asv-pyra-overlay-box-bleed to that padding on an\n     ANCESTOR (it inherits down) so the box extends edge-to-edge with the host,\n     covering that padding's white/background area — matching the CX mockup, where\n     the card touches the screen edges with no gutter beside it. Read with a 0px\n     fallback (not declared on this rule itself) so an unset var still means \"no\n     bleed\" without shadowing an ancestor's value. */\n  margin-left: calc(-1 * var(--asv-pyra-overlay-box-bleed, 0px));\n  margin-right: calc(-1 * var(--asv-pyra-overlay-box-bleed, 0px));\n  width: calc(100% + (2 * var(--asv-pyra-overlay-box-bleed, 0px)));\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  /* Fixed padding on all sides regardless of parent width; NOT affected by the\n     bleed above, so the video/identity row keep the same inset from the box's own\n     edges no matter how far the box bleeds into the host's padding. Left/right is\n     24px per the CX mockup (a wider gutter than top/bottom) — the minimum space\n     between the player and the box's edge. Top/bottom: 16px top, 14px bottom. */\n  padding: 16px 24px 14px;\n  /* Rio token $rio-color-background-secondary (#F0F2F2 light), via its CSS var so\n     it is theme-aware where the host defines it; falls back to the literal. */\n  background: var(--rio-semantic-color-background-secondary, #f0f2f2);\n  border-radius: 8px;\n  font-family: \"Amazon Ember\", Arial, sans-serif;\n  /* The WHOLE box is one ANP tap target (video, identity row, and the padding/gaps\n     between them), so the entire card shows a pointer. */\n  cursor: pointer;\n}\n\n/* Brand identity row: avatar + name/tagline + CTA, below the video. It opens ANP\n   on tap, but the pointer cursor is set on the whole box (which is one tap target),\n   not here. */\n.asv-pyra-overlay-box__identity {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.asv-pyra-overlay-box__identity-text {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-width: 0;\n  flex: 1 1 auto;\n}\n\n/* Circular avatar with an orange ring, per the CX mockup. The small LIVE/\"Just\n   aired\" pill (below) overlaps its bottom edge, so the avatar needs extra bottom\n   space reserved via the wrapper's positioning context. */\n.asv-pyra-overlay-box__avatar {\n  position: relative;\n  flex: 0 0 auto;\n  width: 40px;\n  height: 40px;\n  margin-bottom: 6px;\n  border-radius: 50%;\n  /* The ring itself: a 2px solid Smile Orange border with a small gap from the\n     avatar image, matching the mockup's double-ring look. */\n  box-shadow: 0 0 0 2px #fff, 0 0 0 3px #ff6200;\n  background: #e3e6e6;\n  overflow: visible;\n}\n\n.asv-pyra-overlay-box__avatar-img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  border-radius: 50%;\n  object-fit: cover;\n}\n\n/* Small LIVE/\"Just aired\" pill, overlapping the avatar's bottom edge. Text is set\n   by mountOverlay's setLive (mirrors the top-left video badge's label). */\n.asv-pyra-overlay-box__avatar-badge {\n  position: absolute;\n  left: 50%;\n  bottom: -6px;\n  transform: translateX(-50%);\n  box-sizing: border-box;\n  min-width: 32px;\n  height: 12px;\n  padding: 0 4px;\n  border-radius: 60px;\n  background: #ff6200;\n  color: #fff;\n  font-size: 9px;\n  font-weight: 700;\n  line-height: 11px;\n  text-align: center;\n  white-space: nowrap;\n}\n\n.asv-pyra-overlay-box__text {\n  min-width: 0;\n  flex: 1 1 auto;\n  overflow: hidden;\n}\n\n.asv-pyra-overlay-box__name {\n  /* Rio token $rio-font-family-default at Medium weight. */\n  color: var(--rio-semantic-color-font-primary, #0f1111);\n  font-size: 14px;\n  font-weight: 500;\n  line-height: 20px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.asv-pyra-overlay-box__tagline {\n  /* Rio token $rio-color-font-secondary; text differs LIVE vs previously-live, set\n     by mountOverlay's setLive. */\n  color: var(--rio-semantic-color-font-secondary, #565959);\n  font-size: 11px;\n  font-weight: 400;\n  line-height: 20px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* CTA button (\"Ask a question\" / \"Watch product review\"). Plain (non-purchase)\n   button per Rio's button guidance: 8px corners... but the CX mockup shows this one\n   fully rounded to match the LIVE badge's pill shape, so it is intentionally NOT the\n   default Rio \"Generic button\" radius. */\n.asv-pyra-overlay-box__cta {\n  flex: 0 0 auto;\n  box-sizing: border-box;\n  /* Flex-center the label instead of relying on text-align: a \x3cbutton\x3e is not a\n     block by default, so text-align alone left the label hugging one side of the\n     button's own box (visible whenever content-driven width left extra padding). */\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  height: 24px;\n  padding: 6px 12px;\n  margin: 0;\n  border-radius: 100px;\n  border: 1px solid var(--rio-semantic-color-border-interactive, #888c8c);\n  background: var(--rio-semantic-color-background-interactive, #fff);\n  color: var(--rio-semantic-color-font-primary, #0f1111);\n  font-family: \"Amazon Ember\", Arial, sans-serif;\n  font-size: 13px;\n  font-weight: 400;\n  line-height: 20px;\n  text-align: center;\n  white-space: nowrap;\n  cursor: pointer;\n}\n\n.asv-pyra-overlay-box__cta:hover {\n  background: #f7f8f8;\n}\n\n/* A11y (WCAG 2.4.7): a visible keyboard-focus indicator on the CTA. :focus-visible\n   shows it for keyboard/AT focus only (not a pointer tap). Uses the Rio interactive\n   border token with a Smile-Orange fallback and an offset so it reads against the\n   button's own border. */\n.asv-pyra-overlay-box__cta:focus-visible {\n  outline: 2px solid var(--rio-semantic-color-border-interactive, #ff6200);\n  outline-offset: 2px;\n}\n\n/* Leading CTA icon (chat-bubble live / eye previously-live). The inline SVG paths\n   use fill:currentColor, so this color drives them — mapped to Rio's icon-default\n   token ($rio-color-icon-default) with a #0f1111 fallback for theme-awareness. The\n   icon element is flex-centered and shrink-proof so it never squashes the label. */\n.asv-pyra-overlay-box__cta-icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex: 0 0 auto;\n  color: var(--rio-semantic-color-icon-default, #0f1111);\n}\n\n.asv-pyra-overlay-box__cta-icon svg {\n  display: block;\n}\n\n/* LIVE auto-generated caption line. The overlay paints this itself because Pyra hides\n   native ::cue rendering; positioned near the bottom, above Pyra's control bar. It is\n   non-interactive and aria-hidden (a visual mirror of the audio); the accessible entry\n   point is the CC toggle, not this element. Shown only while live captions are active. */\n.asv-pyra-live-caption {\n  position: absolute;\n  left: 50%;\n  bottom: 84px;\n  transform: translateX(-50%);\n  /* Clamp to at most two lines and wrap inside the pill (never overflow the bar). */\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 2;\n  line-clamp: 2;\n  overflow: hidden;\n  width: 90%;\n  box-sizing: border-box;\n  padding: 2px 8px;\n  border-radius: 4px;\n  background: rgba(15, 17, 17, 0.7);\n  color: #fff;\n  font-size: 13px;\n  line-height: 18px;\n  text-align: center;\n  white-space: normal;\n  overflow-wrap: anywhere;\n  pointer-events: none;\n}\n";
d.head.appendChild(f)}}function N(d){function f(){fa();ha();M&&L&&N&&B&&(O=Date.now());ia()}var h,g,c,b,a,e,m=1<arguments.length&&arguments[1]!==z?arguments[1]:{},k=null!==(h=m.ownerDocument)&&void 0!==h?h:d.ownerDocument;if(!k)throw Error("mountOverlay: container has no owner document");aa(k);var l=m.box;if(l){h=d.parentElement;var n=d.nextSibling;var p=k.createElement("div");p.className="asv-pyra-overlay-box";p.setAttribute("data-testid","asv-pyra-overlay-box");h&&"function"===typeof h.insertBefore&&
h.insertBefore(p,n);p.appendChild(d);h=k.createElement("div");h.className="asv-pyra-overlay-box__identity";n=k.createElement("div");n.className="asv-pyra-overlay-box__identity-text";var r=k.createElement("div");r.className="asv-pyra-overlay-box__avatar";if(l.avatarUrl){var t=k.createElement("img");t.className="asv-pyra-overlay-box__avatar-img";t.setAttribute("src",l.avatarUrl);t.setAttribute("alt","");r.appendChild(t)}var u=k.createElement("div");u.className="asv-pyra-overlay-box__avatar-badge";u.setAttribute("aria-hidden",
"true");r.appendChild(u);n.appendChild(r);t=k.createElement("div");t.className="asv-pyra-overlay-box__text";r=k.createElement("div");r.className="asv-pyra-overlay-box__name";r.textContent=l.brandName;r.setAttribute("title",l.brandName);t.appendChild(r);var v=k.createElement("div");v.className="asv-pyra-overlay-box__tagline";t.appendChild(v);n.appendChild(t);h.appendChild(n);var x=k.createElement("button");x.setAttribute("type","button");x.className="asv-pyra-overlay-box__cta";var A=k.createElement("span");
A.className="asv-pyra-overlay-box__cta-icon";A.setAttribute("aria-hidden","true");x.appendChild(A);var F=k.createElement("span");F.className="asv-pyra-overlay-box__cta-label";x.appendChild(F);h.appendChild(x);p.appendChild(h)}d.classList.add("asv-pyra-overlay-host");"static"===ya(d,k)&&(d.style.position="relative");var D=k.createElement("div");D.classList.add("asv-pyra-overlay");D.setAttribute("data-testid","asv-pyra-overlay");var q=k.createElement("div");q.className="asv-pyra-overlay__live-badge";
